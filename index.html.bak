      width: 54px;
      height: 29px;
      cursor: pointer;
    }

    .publish-text {
      line-height: 16px;
      letter-spacing: 0;
      color: #ffffff;
      font-family: 'Inter', "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", SimHei, Arial, Helvetica, sans-serif;
      font-size: 16px;
    }

    /* 视频预览区域 */
    .video-preview-section {
      display: flex;
      justify-content: center;
      margin-top: 11px;
      margin-bottom: 12px;
    }

    .video-preview-box {
      border-radius: 6px;
      background: #e7e7e7;
      width: 199px;
      height: 263px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .video-preview-label {
      position: absolute;
      top: 66px;
      left: 11px;
      line-height: 67px;
      letter-spacing: 0;
      color: #000000;
      font-family: 'Inter', "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", SimHei, Arial, Helvetica, sans-serif;
      font-size: 48px;
    }

    .play-icon {
      position: absolute;
      top: 109px;
      left: 77px;
      width: 48px;
      height: 48px;
    }

    /* 输入框区域 */
    .input-section {
      margin-left: 17px;
      width: 337px;
      height: 154px;
      position: relative;
    }

    .input-wrapper {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: transparent;
    }

    .share-input-placeholder {
      position: absolute;
      top: 5px;
      left: 7px;
    }

    .input-prompt-box {
      display: inline-flex;
      align-items: flex-start;
      border: 1px solid #000000;
      padding: 2px 5px;
    }

    .input-prompt-text {
      line-height: 22px;
      letter-spacing: 0;
      color: #767676;
      font-family: 'Inter', "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", SimHei, Arial, Helvetica, sans-serif;
      font-size: 16px;
    }

    .share-textarea {
      position: absolute;
      top: 0;
      left: 0;
      width: 337px;
      height: 154px;
      background: transparent;
      border: none;
      outline: none;
      resize: none;
      font-family: 'Inter', "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", SimHei, Arial, Helvetica, sans-serif;
      font-size: 16px;
      line-height: 22px;
      color: #000000;
