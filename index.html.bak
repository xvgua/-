                      <div class="video-rating">
                        <span class="rating-label">评分：</span>
                        <img src=".figma/image/mp25jhz4-anpgmb7.svg" alt="star" class="star-icon">
                        <img src=".figma/image/mp25jhz4-anpgmb7.svg" alt="star" class="star-icon">
                        <img src=".figma/image/mp25jhz4-anpgmb7.svg" alt="star" class="star-icon">
                        <img src=".figma/image/mp25jhz4-anpgmb7.svg" alt="star" class="star-icon">
                        <img src=".figma/image/mp25jhxs-ltf9mxh.svg" alt="empty star" class="star-icon">
                        <span class="rating-score">4分</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- 视频卡片2 -->
                <div class="video-card">
                  <div class="video-thumbnail">
                    <img src=".figma/image/mp25jb5i-791z0kc.png" alt="武氏太极拳002" class="video-img">
                  </div>
                  <div class="video-info">
                    <h3 class="video-title">武氏太极拳002</h3>
                    <p class="video-subtitle">武氏太极</p>
                    <div class="video-meta">
                      <span class="video-duration">50:57</span>
                      <div class="video-rating">
                        <span class="rating-label">评分：</span>
                        <img src=".figma/image/mp25ji1o-zukz0mt.svg" alt="star" class="star-icon">
                        <img src=".figma/image/mp25ji1o-zukz0mt.svg" alt="star" class="star-icon">
                        <img src=".figma/image/mp25ji1o-zukz0mt.svg" alt="star" class="star-icon">
                        <img src=".figma/image/mp25ji1o-zukz0mt.svg" alt="star" class="star-icon">
                        <img src=".figma/image/mp25ji1v-bx6j7uq.svg" alt="empty star" class="star-icon">
