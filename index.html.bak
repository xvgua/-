      </div>

      <!-- 底部导航栏 -->
      <nav class="bottom-nav" v-show="currentPage !== 'videoPractice'">
        <div class="nav-item" @click="switchTab('home')">
          <div class="nav-icon">
            <img src=".figma/image/mp11xoo1-fmanmju.svg" alt="Home">
          </div>
          <span class="nav-label" :class="currentPage === 'home' ? 'text-black' : 'text-gray'">首页</span>
        </div>

        <div class="nav-item" @click="switchTab('video')">
          <div class="nav-icon">
            <img src=".figma/image/mp11xoo5-soglovx.svg" alt="Film">
          </div>
          <span class="nav-label" :class="currentPage === 'video' ? 'text-black' : 'text-gray'">视频</span>
        </div>

        <div class="nav-item" @click="switchTab('favorites')">
          <div class="nav-icon">
            <img src=".figma/image/mp11xonx-bhhijka.svg" alt="Feather">
          </div>
          <span class="nav-label text-gray">收藏</span>
        </div>

        <div class="nav-item" @click="switchTab('profile')">
          <div class="nav-icon">
            <img src=".figma/image/mp11xoo6-bcoav9d.svg" alt="User">
          </div>
          <span class="nav-label text-gray">我的</span>
        </div>
      </nav>

    </div>
  </div>

  <script>
    const { createApp, ref, computed, watch, onMounted, onUnmounted } = Vue;

    createApp({
      setup() {
        const searchQuery = ref('');
        const showPractice = ref(true);
        const currentSlide = ref(0);
        const bannerImages = ref([
          '.figma/image/mp11xono-jwirvsj.png',
          '.figma/image/mp11xoop-thqjq63.png',
          '.figma/image/mp11xoyx-c5m2f7d.png'
        ]);

        const currentPage = ref('home');
        const activeTab = ref('discover');
        const previousPage = ref('home');
        const publishContent = ref('');
        const selectedContacts = ref([]);
        const contactSearchQuery = ref('');

        let autoPlayTimer = null;
        const AUTO_PLAY_INTERVAL = 3000;

        const isDragging = ref(false);
        const startX = ref(0);
        const startY = ref(0);
        const currentX = ref(0);
        const isSwiping = ref(false);

        const goToSlide = (index) => {
          if (index >= 0 && index < bannerImages.value.length) {
            currentSlide.value = index;
            resetAutoPlay();
          }
        };

        const nextSlide = () => {
          currentSlide.value = (currentSlide.value + 1) % bannerImages.value.length;
        };

        const prevSlide = () => {
          currentSlide.value = (currentSlide.value - 1 + bannerImages.value.length) % bannerImages.value.length;
        };

        const startAutoPlay = () => {
          stopAutoPlay();
          autoPlayTimer = setInterval(() => {
            nextSlide();
          }, AUTO_PLAY_INTERVAL);
        };

        const stopAutoPlay = () => {
          if (autoPlayTimer) {
            clearInterval(autoPlayTimer);
            autoPlayTimer = null;
          }
        };

        const resetAutoPlay = () => {
          stopAutoPlay();
          startAutoPlay();
        };

        const handleTouchStart = (e) => {
          isDragging.value = true;
          isSwiping.value = false;
          startX.value = e.touches[0].clientX;
          startY.value = e.touches[0].clientY;
          currentX.value = startX.value;
          stopAutoPlay();
        };

        const handleTouchMove = (e) => {
          if (!isDragging.value) return;

          const x = e.touches[0].clientX;
          const y = e.touches[0].clientY;
          const diffX = Math.abs(x - startX.value);
          const diffY = Math.abs(y - startY.value);

          if (!isSwiping.value && diffX > 10 && diffX > diffY * 1.5) {
            isSwiping.value = true;
          }

          if (isSwiping.value) {
            e.preventDefault();
            currentX.value = x;
          }
        };

        const handleTouchEnd = () => {
          if (!isDragging.value) return;

          const diff = currentX.value - startX.value;
          const threshold = 50;

          if (Math.abs(diff) > threshold && isSwiping.value) {
            if (diff > 0) {
              prevSlide();
            } else {
              nextSlide();
            }
          }

          isDragging.value = false;
          isSwiping.value = false;
          startAutoPlay();
        };

        const handleMouseDown = (e) => {
          isDragging.value = true;
          isSwiping.value = false;
          startX.value = e.clientX;
          startY.value = e.clientY;
          currentX.value = startX.value;
          stopAutoPlay();
        };

        const handleMouseMove = (e) => {
          if (!isDragging.value) return;

          const x = e.clientX;
          const y = e.clientY;
          const diffX = Math.abs(x - startX.value);
          const diffY = Math.abs(y - startY.value);

          if (!isSwiping.value && diffX > 10 && diffX > diffY * 1.5) {
            isSwiping.value = true;
          }

          if (isSwiping.value) {
            e.preventDefault();
            currentX.value = x;
          }
        };

        const handleMouseUp = () => {
          if (!isDragging.value) return;

          const diff = currentX.value - startX.value;
          const threshold = 50;

          if (Math.abs(diff) > threshold && isSwiping.value) {
            if (diff > 0) {
              prevSlide();
            } else {
              nextSlide();
            }
          }

          isDragging.value = false;
          isSwiping.value = false;
          startAutoPlay();
        };

        const switchTab = (tab) => {
          if (tab === 'home') {
            currentPage.value = 'home';
          } else if (tab === 'video') {
            currentPage.value = 'video';
          } else if (tab === 'favorites' || tab === 'favorite') {
            currentPage.value = 'favorite';
          } else if (tab === 'profile') {
            currentPage.value = 'profile';
          }
        };

        const showUserBox = ref(true);

        const toggleUserBoxVisibility = () => {
          showUserBox.value = !showUserBox.value;
        };

        const goToUserDetail = (userName) => {
          previousPage.value = currentPage.value;
          currentPage.value = 'userDetail';
        };

        const goBackFromUserDetail = () => {
          currentPage.value = previousPage.value;
        };

        const goToPractice = () => {
          previousPage.value = currentPage.value;
          currentPage.value = 'practice';
        };

        const goBackFromPractice = () => {
          currentPage.value = previousPage.value;
        };

        const goToVideoPractice = () => {
          console.log('点击进入练习页面');
          previousPage.value = currentPage.value;
          currentPage.value = 'videoPractice';
        };

        const goBackFromVideoPractice = () => {
          currentPage.value = previousPage.value;
        };

        const isMuted = ref(false);

        const toggleSound = () => {
          isMuted.value = !isMuted.value;
        };

        const currentScene = ref(0);
        const isPlaying = ref(true);
        const isZoomed = ref(false);
        let autoSwitchTimer = null;
        let switchInterval = 3000;

        const toggleZoom = () => {
          isZoomed.value = !isZoomed.value;
        };

        const userRating = ref(0);
        let practiceTimer = null;
        let PRACTICE_DURATION = 10000;

        const setRating = (rating) => {
          userRating.value = rating;
        };

        const goToPracticeComplete = () => {
          previousPage.value = currentPage.value;
          currentPage.value = 'practiceComplete';
          stopAutoSwitch();
          if (practiceTimer) {
            clearTimeout(practiceTimer);
            practiceTimer = null;
          }
        };

        const goBackFromPracticeComplete = () => {
          currentPage.value = 'videoPractice';
          startAutoSwitch();
          startPracticeTimer();
        };

        const shareContent = ref('');

        const goToShare = () => {
          console.log('点击分享按钮，跳转到分享页面');
          previousPage.value = currentPage.value;
          currentPage.value = 'practiceShare';
          shareContent.value = '';
        };

        const goBackFromShare = () => {
          console.log('从分享页面返回');
          currentPage.value = previousPage.value;
          shareContent.value = '';
        };

        const onShareInput = () => {
          console.log('输入内容:', shareContent.value);
        };

        const submitShare = () => {
          if (shareContent.value.trim()) {
            console.log('发表成功！跳转到分享成功页面');
            console.log('分享内容:', shareContent.value);
            previousPage.value = 'practiceShare';
            currentPage.value = 'shareSuccess';
          } else {
            alert('请输入内容后再发表');
          }
        };

        const goBackFromShareSuccess = () => {
          console.log('从分享成功页面返回到分享页面');
          currentPage.value = previousPage.value;
        };

        const goToActivityDetail = () => {
          console.log('点击进入动态详情页面');
          previousPage.value = currentPage.value;
          currentPage.value = 'activityDetail';
        };

        const goBackFromActivityDetail = () => {
          console.log('从动态详情页面返回');
          currentPage.value = previousPage.value;
        };

        const isLiked = ref(false);

        const toggleLike = () => {
          isLiked.value = !isLiked.value;
          console.log('点赞状态:', isLiked.value ? '已点赞' : '未点赞');
        };

        const showReplyBox = ref(false);
        const replyContent = ref('');
        const replies = ref([]);

        const openReplyBox = () => {
          showReplyBox.value = true;
          replyContent.value = '';
          console.log('打开回复框');
        };

        const closeReplyBox = () => {
          showReplyBox.value = false;
          replyContent.value = '';
          console.log('关闭回复框');
        };

        const submitReply = () => {
          if (replyContent.value.trim()) {
            replies.value.push({
              author: '我',
              content: replyContent.value.trim()
            });
            console.log('提交回复:', replyContent.value);
            showReplyBox.value = false;
            replyContent.value = '';
          } else {
            alert('请输入回复内容');
          }
        };

        const onReplyInput = () => {
          console.log('输入回复内容:', replyContent.value);
        };

        const searchPageQuery = ref('');

        const goToSearchPage = () => {
          console.log('跳转到搜索页面');
          previousPage.value = currentPage.value;
          currentPage.value = 'search';
          searchPageQuery.value = '';
        };

        const goBackFromSearchPage = () => {
          console.log('从搜索页面返回');
          currentPage.value = previousPage.value;
          searchPageQuery.value = '';
        };

        const onSearchInput = () => {
          console.log('搜索输入:', searchPageQuery.value);
        };

        const goToSearchResult = () => {
          console.log('跳转到搜索结果详情页');
          console.log('当前页面:', currentPage.value);
          console.log('搜索内容:', searchPageQuery.value);
          if (!searchPageQuery.value || searchPageQuery.value.trim() === '') {
            console.log('搜索内容为空，不跳转');
            return;
          }
          previousPage.value = 'search';
          currentPage.value = 'searchResult';
          console.log('新页面:', currentPage.value);
        };

        const goBackFromSearchResult = () => {
          console.log('从搜索结果详情页返回');
          currentPage.value = 'search';
        };

        const startPracticeTimer = () => {
          console.log('启动练习计时器...');
          if (practiceTimer) {
            clearTimeout(practiceTimer);
            practiceTimer = null;
          }
          practiceTimer = setTimeout(() => {
            console.log('10秒到！跳转到练习结束页面');
            goToPracticeComplete();
          }, PRACTICE_DURATION);
          console.log('计时器已设置，将在', PRACTICE_DURATION / 1000, '秒后跳转');
        };

        const startAutoSwitch = () => {
          if (autoSwitchTimer) {
            clearInterval(autoSwitchTimer);
          }
          autoSwitchTimer = setInterval(() => {
            currentScene.value = currentScene.value === 0 ? 1 : 0;
          }, switchInterval);
        };

        const stopAutoSwitch = () => {
          if (autoSwitchTimer) {
            clearInterval(autoSwitchTimer);
            autoSwitchTimer = null;
          }
        };

        const switchSceneManual = () => {
          currentScene.value = currentScene.value === 0 ? 1 : 0;
          if (isPlaying.value) {
            stopAutoSwitch();
            startAutoSwitch();
          }
        };

        const togglePlayPause = () => {
          isPlaying.value = !isPlaying.value;
          if (isPlaying.value) {
            startAutoSwitch();
          } else {
            stopAutoSwitch();
          }
        };

        watch(currentPage, (newPage) => {
          console.log('页面切换到:', newPage);
          if (newPage === 'videoPractice') {
            console.log('进入练习页面，初始化并启动计时器');
            currentScene.value = 0;
            isPlaying.value = true;
            isZoomed.value = false;
            startAutoSwitch();
            startPracticeTimer();
          } else {
            console.log('离开练习页面，停止计时器和自动切换');
            stopAutoSwitch();
            if (practiceTimer) {
              clearTimeout(practiceTimer);
              practiceTimer = null;
            }
          }
        });

        onUnmounted(() => {
          stopAutoSwitch();
          if (practiceTimer) {
            clearTimeout(practiceTimer);
          }
        });

        const switchToVideoPage = (tab) => {
          currentPage.value = 'video';
          activeTab.value = tab;
        };

        const switchToOfficialPage = () => {
          currentPage.value = 'official';
          activeTab.value = 'official';
        };

        const switchToDiscoverPage = () => {
          currentPage.value = 'video';
          activeTab.value = 'discover';
        };

        const switchToFollowPage = () => {
          currentPage.value = 'follow';
          activeTab.value = 'follow';
        };

        const switchToPublishPage = () => {
          previousPage.value = currentPage.value;
          currentPage.value = 'publish';
          publishContent.value = '';
        };

        const goBack = () => {
          currentPage.value = previousPage.value;
        };

        const showMediaUploadTip = () => {
          alert('该功能将在真实项目中实现');
        };

        const submitPublish = () => {
          if (publishContent.value.trim()) {
            alert('发表成功！内容：' + publishContent.value);
            publishContent.value = '';
            goBack();
          } else {
            alert('请输入内容后再发表');
          }
        };

        const switchToContactPage = () => {
          previousPage.value = currentPage.value;
          currentPage.value = 'contact';
        };

        const completeContactSelection = () => {
          selectedContacts.value = [];
          goBack();
        };

        onMounted(() => {
          startAutoPlay();
        });

        onUnmounted(() => {
          stopAutoPlay();
        });

        return {
          searchQuery,
          showPractice,
          currentSlide,
          bannerImages,
          isDragging,
          currentPage,
          activeTab,
          previousPage,
          publishContent,
          selectedContacts,
          contactSearchQuery,
          showUserBox,
          goToSlide,
          nextSlide,
          prevSlide,
          handleTouchStart,
          handleTouchMove,
          handleTouchEnd,
          handleMouseDown,
          handleMouseMove,
          handleMouseUp,
          switchTab,
          switchToVideoPage,
          switchToOfficialPage,
          switchToDiscoverPage,
          switchToFollowPage,
          switchToPublishPage,
          goBack,
          showMediaUploadTip,
          submitPublish,
          switchToContactPage,
          completeContactSelection,
          toggleUserBoxVisibility,
          goToUserDetail,
          goBackFromUserDetail,
          goToPractice,
          goBackFromPractice,
          goToVideoPractice,
          goBackFromVideoPractice,
          isMuted,
          toggleSound,
          currentScene,
          isPlaying,
          switchSceneManual,
          togglePlayPause,
          isZoomed,
          toggleZoom,
          userRating,
          setRating,
          goToPracticeComplete,
          goBackFromPracticeComplete,
          shareContent,
          goToShare,
          goBackFromShare,
          onShareInput,
          submitShare,
          goBackFromShareSuccess,
          goToActivityDetail,
          goBackFromActivityDetail,
          isLiked,
          toggleLike,
          showReplyBox,
          replyContent,
          replies,
          openReplyBox,
          closeReplyBox,
          submitReply,
          onReplyInput,
          searchPageQuery,
          goToSearchPage,
          goBackFromSearchPage,
          onSearchInput,
          goToSearchResult,
          goBackFromSearchResult
        };
      }
    }).mount('#app');
  </script>
</body>
</html>