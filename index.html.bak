            </div>
          </div>

          <!-- 浮动的"现在练习"按钮 -->
          <transition name="fade">
            <div class="floating-practice" v-if="showPractice && currentPage === 'practice'" style="z-index: 35;">
              <div class="ellipse-bg">
                <div class="practice-text">现在
练习</div>
              </div>
            </div>
          </transition>

        </div>

        <!-- 视频练习页面 -->
        <div class="page" :class="{ active: currentPage === 'videoPractice' }">

          <div class="video-practice-container">

            <!-- 正常状态 -->
            <div v-if="!isZoomed" class="normal-view">
              <!-- 顶部视频区域 -->
              <div class="video-practice-top">
                <!-- 返回按钮 -->
                <button class="vp-back-button" @click="goBackFromVideoPractice">
                  <img src=".figma/image/mp19p0jm-jblpzgi.svg" alt="返回">
                </button>

                <!-- Stick figure 视频区域 -->
                <div class="stick-figure-area">
                  <transition name="scene-fade" mode="out-in">
                    <img v-if="currentScene === 0" key="scene0-stick" src=".figma/image/mp19p0j1-t5fahwf.png" alt="动作示范1" class="stick-figure-image">
                    <img v-else key="scene1-stick" src=".figma/image/mp1a3xqz-xbur6rc.png" alt="动作示范2" class="stick-figure-image">
                  </transition>

                  <!-- 右上角：声音图标 -->
                  <button class="sound-toggle-btn" @click="toggleSound">
                    <img v-if="!isMuted" src=".figma/image/mp19qaqt-1du192h.svg" alt="有声音" class="sound-icon">
                    <img v-else src=".figma/image/mp19q1p9-spv9a6g.svg" alt="静音" class="sound-icon">
                  </button>

                  <!-- 向下箭头（点击进入放大状态） -->
                  <button class="expand-arrow-btn" @click="toggleZoom">
                    <img src=".figma/image/mp1ahh29-knxuw0h.svg" alt="展开" class="expand-arrow">
                  </button>

                  <!-- "优秀"按钮 -->
                  <div class="excellent-badge">
                    <span class="excellent-text">优秀</span>
                  </div>
                </div>
              </div>

              <!-- 分隔线 -->
              <div class="divider-line-horizontal"></div>

              <!-- 底部控制区域 -->
              <div class="video-practice-bottom">
                <!-- 实际演练视频预览 -->
                <div class="practice-video-preview">
                  <transition name="scene-fade" mode="out-in">
                    <img v-if="currentScene === 0" key="scene0-video" src=".figma/image/mp19p0jo-ecy3qhj.png" alt="练习视频1" class="preview-video">
                    <img v-else key="scene1-video" src=".figma/image/mp1a41id-3ffig5w.png" alt="练习视频2" class="preview-video">
                  </transition>
                </div>

                <!-- 播放控制栏 -->
                <div class="playback-controls">
                  <button class="control-btn skip-back" @click="switchSceneManual">
                    <img src=".figma/image/mp19p0jm-l4r58vl.svg" alt="后退">
                  </button>
                  <button class="control-btn pause-play" @click="togglePlayPause">
                    <img v-if="isPlaying" src=".figma/image/mp19qiz9-odtz55d.svg" alt="暂停">
                    <img v-else src=".figma/image/mp1a5ezj-i4449sn.svg" alt="播放">
                  </button>
                  <button class="control-btn skip-forward" @click="switchSceneManual">
                    <img src=".figma/image/mp19p0jl-g9gq0dj.svg" alt="前进">
                  </button>
                  <button class="control-btn volume-control" @click="toggleSound">
                    <img v-if="!isMuted" src=".figma/image/mp19qaqt-1du192h.svg" alt="有声音">
                    <img v-else src=".figma/image/mp19q1p9-spv9a6g.svg" alt="静音">
                  </button>
                </div>
              </div>
            </div>

            <!-- 放大状态 -->
            <div v-else class="zoomed-view">
              <!-- 顶部区域 -->
              <div class="zoomed-top-area">
                <!-- 返回按钮 -->
                <button class="vp-back-button-zoomed" @click="goBackFromVideoPractice">
                  <img src=".figma/image/mp19p0jm-jblpzgi.svg" alt="返回">
                </button>

                <!-- 向上箭头（点击回到正常状态） -->
                <button class="collapse-arrow-btn" @click="toggleZoom">
                  <img src=".figma/image/mp1ak106-eg3h9nk.svg" alt="收起" class="collapse-arrow">
                </button>

                <!-- 右上角：声音图标 -->
                <button class="sound-toggle-btn-zoomed" @click="toggleSound">
                  <img v-if="!isMuted" src=".figma/image/mp19qaqt-1du192h.svg" alt="有声音" class="sound-icon">
                  <img v-else src=".figma/image/mp19q1p9-spv9a6g.svg" alt="静音" class="sound-icon">
                </button>
              </div>

              <!-- 放大的图片区域 -->
              <div class="zoomed-image-container">
                <transition name="scene-fade" mode="out-in">
                  <div v-if="currentScene === 0" key="zoomed-scene0" class="zoomed-image-wrapper">
                    <img src=".figma/image/mp1aicus-pzpgejh.png" alt="放大图1" class="zoomed-image">
                    <div class="excellent-badge-zoomed">
                      <span class="excellent-text">优秀</span>
                    </div>
                  </div>
                  <div v-else key="zoomed-scene1" class="zoomed-image-wrapper">
                    <img src=".figma/image/mp1ajusr-pujcqv1.png" alt="放大图2" class="zoomed-image">
                    <div class="excellent-badge-zoomed">
                      <span class="excellent-text">良好</span>
                    </div>
                  </div>
                </transition>
              </div>

              <!-- 底部控制栏（放大状态） -->
              <div class="playback-controls-zoomed">
                <button class="control-btn skip-back" @click="switchSceneManual">
                  <img src=".figma/image/mp19p0jm-l4r58vl.svg" alt="后退">
                </button>
                <button class="control-btn pause-play" @click="togglePlayPause">
                  <img v-if="isPlaying" src=".figma/image/mp19qiz9-odtz55d.svg" alt="暂停">
                  <img v-else src=".figma/image/mp1a5ezj-i4449sn.svg" alt="播放">
                </button>
                <button class="control-btn skip-forward" @click="switchSceneManual">
                  <img src=".figma/image/mp19p0jl-g9gq0dj.svg" alt="前进">
                </button>
                <button class="control-btn volume-control" @click="toggleSound">
                  <img v-if="!isMuted" src=".figma/image/mp19qaqt-1du192h.svg" alt="有声音">
                  <img v-else src=".figma/image/mp19q1p9-spv9a6g.svg" alt="静音">
                </button>
              </div>
            </div>

          </div>

        </div>

        <!-- 练习结束页面 -->
        <div class="page" :class="{ active: currentPage === 'practiceComplete' }">

          <div class="practice-complete-container">

            <!-- 顶部白色背景区域 -->
            <div class="complete-header-area">
              <!-- 顶部栏：返回按钮 + 用户信息 + 分享 -->
              <div class="complete-top-bar">
                <button class="complete-back-btn" @click="goBackFromPracticeComplete">
                  <img src=".figma/image/mp1aztwg-byo904l.svg" alt="返回">
                </button>

                <div class="user-info-section">
                  <div class="user-tab">
                    <span class="user-name">林悦</span>
                  </div>
                  <span class="practice-date">2026/3/31</span>
                </div>

                <button class="share-btn" @click="goToShare">
                  <img src=".figma/image/mp1aztxb-smuye9g.svg" alt="分享">
                </button>
              </div>

              <!-- 提示文字 -->
              <p class="complete-prompt-text">
                完成了对《xxx太极拳教程》的<br>一次练习！给这次的练习一个评价吧！
              </p>

              <!-- 星级评分 -->
              <div class="rating-stars-container">
                <button
                  v-for="(star, index) in 5"
                  :key="index"
                  class="star-btn"
                  @click="setRating(index + 1)"
                >
                  <img v-if="index < userRating" src=".figma/image/mp1awjgw-rwkcp1q.svg" alt="实心星" class="star-icon">
                  <img v-else src=".figma/image/mp1awjgw-ilytwn7.svg" alt="空心星" class="star-icon">
                </button>
                <span class="rating-score">{{ userRating }}分</span>
              </div>
            </div>

            <!-- AI点评区域（可滚动） -->
            <div class="ai-review-scroll-area">
              <div class="ai-review-content">
                <p class="ai-review-title">AI点评：</p>

                <!-- AI点评图片 -->
                <img src=".figma/image/mp1awjgx-itdjo39.png" alt="AI点评图" class="ai-review-image">

                <p class="review-subtitle">动作仍需加强的招式：</p>

                <!-- 需要加强的招式 -->
                <div class="improve-action-row">
                  <img src=".figma/image/mp1awjgx-itdjo39.png" alt="招式图" class="action-thumbnail">
                  <p class="action-comment">这一招还需要努力：动作还需要更加到位一些才好</p>
                </div>

                <!-- AI详细点评文字 -->
                <p class="ai-detailed-review">
                  &nbsp;&nbsp;整体动作节奏舒缓匀和，拳架身形端正沉稳，松肩沉胯做得比较到位，招式衔接流畅自然。气息和动作配合协调，心态放松、体态舒展，能看出跟着教程认真练习。稍不足是个别动作架子略偏高，腰腿发力可以再扎实一些，坚持练习会更有太极沉稳内敛的韵味。
                  <br><br><br>
                  练习得比较好的招式：
                  <br><br>
                  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;这一招很标准！动作完美
                  <br>
                  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;呈现了太极......&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                  <br><br><br><br>
                </p>
              </div>
            </div>

            <!-- 用户头像（左下角） -->
            <img src=".figma/image/mp1aztwj-u3pjp0x.svg" alt="用户头像" class="user-avatar-complete">

          </div>

        </div>

        <!-- 练习分享页面 -->
        <div class="page" :class="{ active: currentPage === 'practiceShare' }">

          <div class="practice-share-container">

            <!-- 顶部工具栏：返回 + 发表 -->
            <div class="share-toolbar">
              <button class="share-back-btn" @click="goBackFromShare">
                <img src=".figma/image/mp1cbzju-6ogp8kf.svg" alt="返回">
              </button>
