      font-size: 64px;
      font-weight: normal;
    }

    /* 推荐内容区域 */
    .recommendation-area {
      position: absolute;
      top: 233px;
      left: -2px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      background: #ededed;
