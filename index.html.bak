              <!-- 底部提示文字 -->
              <div class="practice-bottom-tip">
                <p class="tip-text">到底了_(:з」∠)_</p>
                <div class="tip-rating-row">
                  <span class="tip-rating-label">评分：</span>
                  <img src=".figma/image/mp192bdx-94r7011.svg" alt="星" class="practice-star">
                  <img src=".figma/image/mp192bdx-94r7011.svg" alt="星" class="practice-star">
                  <img src=".figma/image/mp192bdx-94r7011.svg" alt="星" class="practice-star">
                  <img src=".figma/image/mp192bdx-94r7011.svg" alt="星" class="practice-star">
                  <img src=".figma/image/mp192bdx-kyhfecp.svg" alt="半星" class="practice-star">
                  <span class="practice-score">4分</span>
                </div>
