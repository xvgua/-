              <div class="practice-video-card">
                <div class="practice-card-image-wrapper">
                  <img src=".figma/image/mp192be6-pbrt2eh.png" alt="武当太极十三势" class="practice-card-image">
                  <span class="practice-duration">50:57</span>
                </div>
                <div class="practice-card-info">
                  <h3 class="practice-video-title">武当太极十三势</h3>
                  <div class="practice-rating-row">
                    <span class="practice-rating-label">评分：</span>
                    <img src=".figma/image/mp192bdx-94r7011.svg" alt="星" class="practice-star">
                    <img src=".figma/image/mp192bdx-94r7011.svg" alt="星" class="practice-star">
                    <img src=".figma/image/mp192bdx-94r7011.svg" alt="星" class="practice-star">
                    <img src=".figma/image/mp192bdx-94r7011.svg" alt="星" class="practice-star">
                    <img src=".figma/image/mp192bdx-kyhfecp.svg" alt="半星" class="practice-star">
                    <span class="practice-score">4分</span>
