    }

    .share-back-btn {
      width: 40px;
      height: 40px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
    }

    .share-back-btn img {
      width: 40px;
      height: 40px;
    }

    .publish-button {
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #000000;
      border-radius: 8px;
      background: #000000;
